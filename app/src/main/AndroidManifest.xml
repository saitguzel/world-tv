<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV / Google TV -->
    <!-- required=false, not absent: the app still declares itself TV-capable so TV
         launchers surface it, but Play may now serve it to phones as well. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Cheap TV boxes report no microphone; voice search must stay optional. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Radio playback continues with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="merge" />

    <application
        android:name=".WorldTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorldTV">

        <!-- No screenOrientation attribute: MainActivity locks landscape at runtime on
             TV only, so a phone can rotate. configChanges already absorbs the rotation,
             so nothing is recreated either way. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WorldTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Without LEANBACK_LAUNCHER the app is invisible on the TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- ...and without LAUNCHER it is invisible on a phone. Both in one
                     filter is what a single adaptive APK needs. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google Assistant voice search ("play BBC News on WorldTV"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- Hilt supplies the WorkerFactory, so the default WorkManager initializer
             must be removed and replaced by on-demand initialisation. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
